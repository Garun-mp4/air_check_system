# PostgreSQL
POSTGRES_DB=air_quality
POSTGRES_USER=air_quality
POSTGRES_PASSWORD=air_quality_dev
DATABASE_URL=postgres://air_quality:air_quality_dev@localhost:5432/air_quality

# TypeScript server + React frontend (Next.js)
PORT=3000
HOSTNAME=0.0.0.0
ML_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=
HISTORY_LIMIT=200
ML_HISTORY_LIMIT=200
ML_REQUEST_TIMEOUT_MS=5000
CO2_NORMAL_THRESHOLD=800
CO2_CRITICAL_THRESHOLD=1000
DEVICE_ID=room-01
DEVICE_HEARTBEAT_TIMEOUT_MS=90000
WINDOW_MANUAL_OVERRIDE_MINUTES=30
AUTO_VENTILATION_MINIMUM_MINUTES=5
AUTOMATION_ENABLED=true

# ML service
ML_PORT=8000
MODEL_PATH=/app/model/model.joblib
MODEL_VERSION=1.0
MIN_TRAINING_ROWS=30

# Sensor simulator: same POST contract will be used by ESP32
BACKEND_URL=http://localhost:3000
DEVICE_ID=room-01
SIMULATOR_MODE=live
SIMULATOR_INTERVAL_SECONDS=30
SCENARIO=normal
INITIAL_CO2=650
BASE_TEMPERATURE=23
BASE_HUMIDITY=45
RANDOM_SEED=42
RETRY_ATTEMPTS=4
RETRY_BASE_DELAY_SECONDS=1
REQUEST_TIMEOUT_SECONDS=5
BACKFILL_POINTS=480
BACKFILL_INTERVAL_SECONDS=30
