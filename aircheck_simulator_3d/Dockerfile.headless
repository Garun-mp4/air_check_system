FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY aircheck_simulator_3d/requirements-headless.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY aircheck_simulator_3d/ ./aircheck_simulator_3d/
EXPOSE 8090
CMD ["python", "-m", "uvicorn", "aircheck_simulator_3d.networking.web_service:create_web_service", "--factory", "--host", "0.0.0.0", "--port", "8090"]
