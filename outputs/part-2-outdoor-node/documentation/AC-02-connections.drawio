        <mxCell id="title" value="AirCheck AC-02 • наружный измерительный узел • R04&#10;Функциональная схема соединений; не принципиальная Э3" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fillColor=#e7edf0;strokeColor=#263944;fontColor=#172b34;spacing=12;strokeWidth=2;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="25" y="24" width="1180" height="74" />
        </mxCell>
        <mxCell id="usb" value="ПИТАНИЕ&#10;&#10;Один адаптер USB&#10;5 В / 2 А&#10;Micro-USB ESP32&#10;&#10;Не подавать второй&#10;источник на 5V / 3V3" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#fff5df;strokeColor=#263944;fontColor=#172b34;spacing=12;strokeWidth=2;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="305" width="220" height="250" />
        </mxCell>
        <mxCell id="esp" value="ESP32-DevKitC-32E V4&#10;ESP32-WROOM-32E&#10;&#10;J2.19: 5V от USB&#10;J2.1: 3V3&#10;J3.1 / J3.7: GND&#10;J3.11: GPIO17 TX&#10;J3.12: GPIO16 RX&#10;J3.6: GPIO21 SDA&#10;J3.3: GPIO22 SCL" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#e4f0ee;strokeColor=#263944;fontColor=#172b34;spacing=12;strokeWidth=2;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="385" y="225" width="350" height="385" />
        </mxCell>
        <mxCell id="sht" value="Adafruit SHT45 #5665&#10;версия без PTFE&#10;&#10;VIN ← 3V3&#10;GND ← общий GND&#10;SDA ↔ GPIO21&#10;SCL ← GPIO22&#10;I²C address 0x44" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#edf4ff;strokeColor=#263944;fontColor=#172b34;spacing=12;strokeWidth=2;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="870" y="170" width="300" height="240" />
        </mxCell>
        <mxCell id="sps" value="Sensirion SPS30&#10;JST ZHR-5&#10;&#10;pin 1 VDD ← 5V&#10;pin 2 RX ← GPIO17 TX&#10;pin 3 TX → GPIO16 RX&#10;pin 4 SEL: NC / floating&#10;pin 5 GND ← общий GND&#10;UART 115200, 8N1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#eef5e6;strokeColor=#263944;fontColor=#172b34;spacing=12;strokeWidth=2;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="870" y="465" width="300" height="280" />
