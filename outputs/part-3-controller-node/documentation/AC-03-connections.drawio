<mxfile host="app.diagrams.net" modified="2026-10-11T16:30:00.000Z" agent="Codex" version="31.5.3" type="device">
  <diagram id="AC03-function-R01-20261011" name="Структура и интерфейсы">
    <mxGraphModel dx="1800" dy="1040" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="AirCheck AC-03 — узел управления и связи" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#13202B;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="55" y="28" width="1300" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Цифровой прототип R01 · ESP32-DevKitC-32E V4 · размеры корпуса в мм · 11.10.2026" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#52616B;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="58" y="75" width="1350" height="30" as="geometry"/></mxCell>
        <mxCell id="zone-data" value="Сбор измерений и связь с AirCheck" style="swimlane;html=1;rounded=0;horizontal=1;startSize=38;collapsible=0;fillColor=#F8FAFC;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#334155;fontStyle=1;fontSize=17;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="45" y="125" width="1710" height="425" as="geometry"/></mxCell>
        <mxCell id="zone-act" value="Управляющие сигналы и внешние исполнительные устройства" style="swimlane;html=1;rounded=0;horizontal=1;startSize=38;collapsible=0;fillColor=#FBFCFD;swimlaneFillColor=#FBFCFD;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#334155;fontStyle=1;fontSize=17;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="45" y="580" width="1710" height="330" as="geometry"/></mxCell>
        <mxCell id="node-a" value="&lt;b&gt;Узел A · внутри помещения&lt;/b&gt;&lt;br&gt;ESP32 + SCD41 + SPS30&lt;br&gt;Формирует внутренние измерения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1F5;strokeColor=#497083;strokeWidth=2;fontColor=#172B34;fontSize=17;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="205" width="315" height="125" as="geometry"/></mxCell>
        <mxCell id="node-b" value="&lt;b&gt;Узел B · наружный измерительный&lt;/b&gt;&lt;br&gt;ESP32 + SHT45 + SPS30&lt;br&gt;Формирует наружные измерения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1F5;strokeColor=#497083;strokeWidth=2;fontColor=#172B34;fontSize=17;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="380" width="315" height="125" as="geometry"/></mxCell>
        <mxCell id="gateway" value="&lt;b&gt;Узел C · шлюз AC-03&lt;/b&gt;&lt;br&gt;ESP32-DevKitC-32E V4&lt;br&gt;&lt;br&gt;Принимает A/B по ESP-NOW&lt;br&gt;Объединяет данные в room-01&lt;br&gt;Передаёт измерения и опрашивает команды&lt;br&gt;Отчитывается о состоянии устройства" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEDEA;strokeColor=#2F726E;strokeWidth=2.5;fontColor=#172B34;fontSize=18;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="565" y="205" width="410" height="290" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;AirCheck API · device_id = room-01&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST /api/v1/measurements&lt;br&gt;GET /api/v1/controls/commands&lt;br&gt;POST /api/v1/controls/state&lt;br&gt;&lt;br&gt;Команда остаётся pending, пока устройство&lt;br&gt;не подтвердит соответствующее состояние" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0ECF8;strokeColor=#75639B;strokeWidth=2;fontColor=#172B34;fontSize=17;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1315" y="235" width="365" height="235" as="geometry"/></mxCell>
        <mxCell id="power" value="Питание и сервис&lt;br&gt;Micro-USB, 5 V только для платы ESP32&lt;br&gt;Через этот же порт — прошивка и диагностика" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#B58124;strokeWidth=1.8;fontColor=#392B13;fontSize=16;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="565" y="135" width="410" height="62" as="geometry"/></mxCell>
        <mxCell id="limits" value="&lt;b&gt;Внешние концевые выключатели&lt;/b&gt;&lt;br&gt;Открытие окна → GPIO33&lt;br&gt;Закрытие окна → GPIO18&lt;br&gt;NC на GND, вход с pull-up&lt;br&gt;Разрыв провода также даёт HIGH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEFEA;strokeColor=#A85B45;strokeWidth=2;fontColor=#38231D;fontSize=16;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="660" width="315" height="175" as="geometry"/></mxCell>
        <mxCell id="driver" value="&lt;b&gt;Внешние драйверы нагрузок&lt;/b&gt;&lt;br&gt;Входы, совместимые с логикой 3,3 V&lt;br&gt;GPIO25 — вытяжка · GPIO26 — приток&lt;br&gt;GPIO27 — окно открыть · GPIO32 — закрыть&lt;br&gt;Внешнее питание; входы LOW при сбросе&lt;br&gt;Модели и разъёмы не выбраны, вне AC-03" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#B58124;strokeWidth=2;fontColor=#392B13;fontSize=15;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="565" y="650" width="410" height="190" as="geometry"/></mxCell>
        <mxCell id="actuators" value="&lt;b&gt;Исполнительные устройства · вне комплекта AC-03&lt;/b&gt;&lt;br&gt;&lt;br&gt;Вентилятор вытяжки · FAN_EXHAUST_ENABLE&lt;br&gt;Вентилятор притока · FAN_INTAKE_ENABLE&lt;br&gt;Привод окна · WINDOW_OPEN / WINDOW_CLOSE&lt;br&gt;&lt;br&gt;GPIO не питает двигатель, вентилятор или катушку реле" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEFEA;strokeColor=#A85B45;strokeWidth=2;fontColor=#38231D;fontSize=16;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1195" y="650" width="485" height="190" as="geometry"/></mxCell>
        <mxCell id="e-a-c" value="ESP-NOW · канал узла C" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2F726E;strokeWidth=2.5;fontColor=#254F4C;fontSize=15;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="node-a" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-b-c" value="ESP-NOW · тот же канал" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2F726E;strokeWidth=2.5;fontColor=#254F4C;fontSize=15;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="node-b" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c-api" value="Wi-Fi · измерения и POST состояния" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#75639B;strokeWidth=2.5;fontColor=#51436D;fontSize=15;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="gateway" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-api-c" value="GET очередь команд" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=block;startFill=1;endArrow=none;strokeColor=#75639B;strokeWidth=1.8;dashed=1;fontColor=#51436D;fontSize=15;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="gateway" target="api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1035" y="520"/><mxPoint x="1250" y="520"/></Array></mxGeometry></mxCell>
        <mxCell id="e-power" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B58124;strokeWidth=1.8;fontColor=#71521C;fontSize=14;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="power" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c-driver" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B58124;strokeWidth=2;dashed=1;fontColor=#71521C;fontSize=14;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="gateway" target="driver"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-driver-load" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#A85B45;strokeWidth=2;dashed=1;fontColor=#764434;fontSize=14;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="driver" target="actuators"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-limits-c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#A85B45;strokeWidth=2;dashed=1;fontColor=#764434;fontSize=14;labelBackgroundColor=#FBFCFD;" edge="1" parent="1" source="limits" target="gateway"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="747"/><mxPoint x="470" y="470"/></Array></mxGeometry></mxCell>
        <mxCell id="note" value="Важно: схема функциональная и не является электрической принципиальной схемой Э3. Драйверы, силовое питание, кабельные разъёмы и исполнительные устройства не выбраны. До их выбора интерфейсы GPIO остаются проектными; фактическое состояние нагрузки нельзя подтверждать только уровнем выходного сигнала." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#334155;fontSize=16;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="90" y="930" width="1590" height="76" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
